{
  "rules": {
    ".read": false,
    ".write": false,
    "access": {
      "owners": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "devices": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    },
    "vault": {
      "status": {
        ".read": true,
        ".write": "auth != null && root.child('access/devices').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['state', 'updatedAt']) && !newData.hasChild('code')",
        "state": {
          ".validate": "newData.isString() && newData.val().matches(/^(IDLE|LOCKED|DIALING|UNLOCKED|ALARM|UNKNOWN)$/)"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        }
      },
      "events": {
        ".read": true,
        ".write": "auth != null && root.child('access/devices').child(auth.uid).val() === true",
        "$id": {
          ".validate": "newData.hasChildren(['type','at']) && newData.child('type').isString() && newData.child('at').isNumber() && !newData.hasChild('code')",
          "feedback": {
            ".validate": "newData.isString() && newData.val().matches(/^[012]{3}$/) && newData.parent().child('type').val() === 'attempt' && newData.parent().child('guess').isString() && newData.parent().child('guess').val().matches(/^[0-9]{3}$/)"
          }
        },
        ".indexOn": ["at"]
      },
      "leaderboard": {
        ".read": true,
        ".write": "auth != null && root.child('access/devices').child(auth.uid).val() === true",
        ".indexOn": ["seconds"],
        "$id": {
          ".validate": "newData.hasChildren(['player','seconds','attempts','at']) && !newData.hasChild('code')",
          "player": {
            ".validate": "newData.isString() && newData.val().length <= 24"
          },
          "seconds": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "attempts": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          },
          "at": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "commands": {
        ".read": "auth != null && (root.child('access/owners').child(auth.uid).val() === true || root.child('access/devices').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('access/devices').child(auth.uid).val() === true",
        "$id": {
          ".write": "auth != null && root.child('access/owners').child(auth.uid).val() === true && !data.exists() && newData.exists()",
          ".validate": "newData.hasChildren(['action','at']) && (newData.child('action').val() === 'disarm' || (newData.child('action').val() === 'arm' && newData.hasChildren(['code','player'])))",
          "action": {
            ".validate": "newData.val() === 'arm' || newData.val() === 'disarm'"
          },
          "code": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{3}$/)"
          },
          "player": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
          },
          "pattern": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 255 && newData.val() % 1 === 0"
          },
          "at": {
            ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 5000"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "commandResults": {
        ".read": "auth != null && (root.child('access/owners').child(auth.uid).val() === true || root.child('access/devices').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('access/devices').child(auth.uid).val() === true",
        "$id": {
          ".validate": "newData.hasChild('result') && newData.child('result').isString() && !newData.hasChild('code')"
        }
      },
      "aiMessage": {
        ".read": true,
        ".write": "auth != null && root.child('access/devices').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['roundId','eventId','actionRevision','message','source','at'])",
        "roundId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 32"
        },
        "eventId": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 48"
        },
        "actionRevision": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 191"
        },
        "source": {
          ".validate": "newData.val() === 'local' || newData.val() === 'gemini'"
        },
        "at": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      },
      "aiSettings": {
        ".read": "auth != null && (root.child('access/owners').child(auth.uid).val() === true || root.child('access/devices').child(auth.uid).val() === true)",
        "enabled": {
          ".write": "auth != null && root.child('access/owners').child(auth.uid).val() === true",
          ".validate": "newData.isBoolean()"
        },
        "$other": {
          ".validate": false
        }
      },
      "aiStatus": {
        ".read": "auth != null && root.child('access/owners').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('access/devices').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['enabled','configured','hasCode','health','cooldownSeconds','lastSuccessUptimeS','freeHeap','updatedAt'])",
        "enabled": {
          ".validate": "newData.isBoolean()"
        },
        "configured": {
          ".validate": "newData.isBoolean()"
        },
        "hasCode": {
          ".validate": "newData.isBoolean()"
        },
        "health": {
          ".validate": "newData.isString() && newData.val().matches(/^(rate-limited|waiting-settings|not-configured|requesting|ready|offline|quota-cooldown|key-rejected|model-unavailable|invalid-response|network-timeout|low-memory|worker-unavailable|unavailable)$/)"
        },
        "cooldownSeconds": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "lastSuccessUptimeS": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "freeHeap": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
