# Copy to ../../Project_Secrets/.env.local relative to web/.
# Public Firebase web configuration only. Never put passwords in VITE_* fields.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=

# Local testing only; never enable for Hosting builds.
VITE_USE_EMULATORS=false
